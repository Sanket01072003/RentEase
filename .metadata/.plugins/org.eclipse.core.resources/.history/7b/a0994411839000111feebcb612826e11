	@Override
	public ResponseDto createRental(RentalDTO rental) {
		Renter renter = renterRepository.findById(rental.getRenterId()).orElseThrow(() -> new CustomException("Renter Not Found!"));
		Products product = productRepository.findById(rental.getProductId()).orElseThrow(() -> new CustomException("Product not Found!"));
		// Check product is available
        if (product.getStatus() != Availability.AVAILABLE)
            throw new RuntimeException("Product is not available!");

        // Calculate total rent
        long days = ChronoUnit.DAYS.between(
        		rental.getFromDate(), rental.getToDate());

        if (days <= 0)
            throw new RuntimeException(
                "To date must be after from date!");

        double totalRent = days * product.getPricePerDay();

        // Create rental
        Rental r = new Rental();
        r.setRenter(renter);
        r.setProduct(product);
        r.setFromDate(rental.getFromDate());
        r.setToDate(rental.getToDate());
        r.setTotalRent(totalRent);
//        r.setDepositAmount(product.getDepositAmount());
//        r.setStatus(RentalStatus.ACTIVE);
//
//        // Mark product as rented
//        product.setStatus(Availability.RENTED);
//        productRepository.save(product);
//
//        Rental saved = rentalRepository.save(r);
        r.setDepositAmount(product.getDepositAmount());
        r.setStatus(RentalStatus.PENDING_PAYMENT);

        Rental saved = rentalRepository.save(r);
        
        return new ResponseDto("Rental Created Successfully" , "Success" , LocalDateTime.now() , saved);

	}

