	@Override
	public ResponseDto confirmReturn(Long id) {
	    Rental rental = rentalRepository.findById(id)
	            .orElseThrow(() ->
	                new CustomException("Rental Not Found!"));

	    if (rental.getStatus() != RentalStatus.ACTIVE)
	        throw new CustomException("Rental is not Active!");

	    rental.setStatus(RentalStatus.RETURNED);

	    Products product = rental.getProduct();
	    product.setStatus(Availability.AVAILABLE);
	    productRepository.save(product);

	    rentalRepository.save(rental);

	    // ✅ Trigger deposit refund via Payment Service
	    paymentService.refundDeposit(id);

	    return new ResponseDto(
	        "Product Returned & Deposit Refund Initiated!",
	        "Success",
	        LocalDateTime.now(),
	        rental
	    );
	}

	@Override
	public ResponseDto cancel(Long id) {
		Rental rental = rentalRepository.findById(id).orElseThrow(() -> new CustomException("Rental Not Found!"));
		
//		if(rental.getStatus() != RentalStatus.ACTIVE) {
//			throw new CustomException("Only Active Rentals can be cancelled!");
//		}
		
		
		
		//Update Rental Status 
		rental.setStatus(RentalStatus.CANCELLED);
		
		// Make product available again
		Products product = rental.getProduct();
		product.setStatus(Availability.AVAILABLE);
		productRepository.save(product);
		
		// Note: Razorpay deposit refund will be added later
		
		Rental saved = rentalRepository.save(rental);
		return new ResponseDto("Rental Cancelled Successfully!" , "Success" , LocalDateTime.now() , saved);
	}
	
}
